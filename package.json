{
  "name": "trip-sheets",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first, offline-capable travel itinerary site that uses Google Sheets as the only source of truth and ships as a static PWA on GitHub Pages.",
  "keywords": [
    "travel",
    "itinerary",
    "google-sheets",
    "google-sheets-api",
    "nextjs",
    "react",
    "typescript",
    "static-site",
    "ssg",
    "static-export",
    "github-pages",
    "pwa",
    "offline-first",
    "service-worker",
    "chakra-ui",
    "vitest",
    "mobile-first",
    "template"
  ],
  "license": "MIT",
  "author": "Kevin Shih",
  "homepage": "https://github.com/KevinShih-689/trip-sheets#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinShih-689/trip-sheets.git"
  },
  "bugs": {
    "url": "https://github.com/KevinShih-689/trip-sheets/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "fetch-sheet": "tsx scripts/fetch-sheet.ts",
    "fetch-sheet:sample": "node -e \"require('fs').copyFileSync('data/trip-data.sample.json','data/trip-data.json');console.log('sample data -> data/trip-data.json')\"",
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.2.3",
    "@emotion/react": "^11.14.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "googleapis": "^144.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3",
    "zod": "^3.24.1"
  }
}
