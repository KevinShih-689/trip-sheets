{
  "name": "trip-sheets",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first, offline-capable travel itinerary site that uses Google Sheets as the only source of truth and ships as a static PWA on GitHub Pages.",
  "keywords": [
    "travel",
    "itinerary",
    "google-sheets",
    "google-sheets-api",
    "nextjs",
    "react",
    "typescript",
    "static-site",
    "ssg",
    "static-export",
    "github-pages",
    "pwa",
    "offline-first",
    "service-worker",
    "chakra-ui",
    "vitest",
    "mobile-first",
    "template"
  ],
  "license": "MIT",
  "author": "Kevin Shih",
  "homepage": "https://github.com/KevinShih-689/trip-sheets#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinShih-689/trip-sheets.git"
  },
  "bugs": {
    "url": "https://github.com/KevinShih-689/trip-sheets/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "fetch-sheet": "tsx scripts/fetch-sheet.ts",
    "fetch-sheet:sample": "node -e \"require('fs').copyFileSync('data/trip-data.sample.json','data/trip-data.json');console.log('sample data -> data/trip-data.json')\"",
    "fetch-stores": "tsx scripts/fetch-stores.ts",
    "fetch-stores:check": "tsx scripts/fetch-stores.ts --dry-run",
    "fetch-stores:sample": "node -e \"require('fs').copyFileSync('data/stores.sample.json','data/stores.json');console.log('sample data -> data/stores.json')\"",
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.2.3",
    "@emotion/react": "^11.14.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "eslint-config-prettier": "^10.1.8",
    "googleapis": "^144.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3",
    "zod": "^3.24.1"
  }
}
